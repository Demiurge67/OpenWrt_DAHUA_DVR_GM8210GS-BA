From: OpenWrt Porting Team <openwrt@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH 01/10] arm: add gm8210 machine support

Add basic machine support for Grain Media GM8210 SoC

Signed-off-by: OpenWrt Porting Team <openwrt@example.com>
---
 arch/arm/Kconfig                  |  6 ++++++
 arch/arm/Makefile                 |  1 +
 arch/arm/mach-grainmedia/Kconfig  | 10 ++++++++++
 arch/arm/mach-grainmedia/Makefile |  3 +++
 arch/arm/mach-grainmedia/gm8210.c | 25 +++++++++++++++++++++++++
 5 files changed, 45 insertions(+)
 create mode 100644 arch/arm/mach-grainmedia/Kconfig
 create mode 100644 arch/arm/mach-grainmedia/Makefile
 create mode 100644 arch/arm/mach-grainmedia/gm8210.c

diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
index xxxxxxx..xxxxxxx 100644
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -400,6 +400,12 @@ config ARCH_GEMINI
 	select ARCH_REQUIRE_GPIOLIB
 	select ZONE_DMA
 
+config ARCH_GM8210
+	bool "Grain Media GM8210"
+	select CPU_FA726TE
+	select ARCH_REQUIRE_GPIOLIB
+	help
+	  Support for Grain Media GM8210 SoC
+
 endchoice
 
 config ARCH_SHMOBILE
diff --git a/arch/arm/Makefile b/arch/arm/Makefile
index xxxxxxx..xxxxxxx 100644
--- a/arch/arm/Makefile
+++ b/arch/arm/Makefile
@@ -133,6 +133,7 @@ textofs-$(CONFIG_ARCH_MSM8X60) := 0x00208000
 textofs-$(CONFIG_ARCH_MSM8960) := 0x00208000
 textofs-$(CONFIG_ARCH_AXXIA) := 0x00308000
 
+machine-$(CONFIG_ARCH_GM8210)		+= grainmedia
 machine-$(CONFIG_ARCH_AC5)		+= altera
 machine-$(CONFIG_ARCH_EBSA110)		+= ebsa110
 machine-$(CONFIG_ARCH_EP93XX)		+= ep93xx
diff --git a/arch/arm/mach-grainmedia/Kconfig b/arch/arm/mach-grainmedia/Kconfig
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/arch/arm/mach-grainmedia/Kconfig
@@ -0,0 +1,10 @@
+if ARCH_GM8210
+
+config MACH_GM8210
+	bool "Grain Media GM8210 SoC"
+	help
+	  Support for Grain Media GM8210 SoC
+
+endif
+
+endmenu
diff --git a/arch/arm/mach-grainmedia/Makefile b/arch/arm/mach-grainmedia/Makefile
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/arch/arm/mach-grainmedia/Makefile
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_MACH_GM8210) += gm8210.o
+
diff --git a/arch/arm/mach-grainmedia/gm8210.c b/arch/arm/mach-grainmedia/gm8210.c
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/arch/arm/mach-grainmedia/gm8210.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/of_platform.h>
+#include <asm/mach/arch.h>
+
+static const char * const gm8210_dt_compat[] __initconst = {
+	"faraday,gm8210",
+	"grainmedia,gm8210", 
+	NULL,
+};
+
+DT_MACHINE_START(GM8210_DT, "Grain Media GM8210")
+	.dt_compat	= gm8210_dt_compat,
+	.restart	= arm_machine_restart,
+MACHINE_END
+
+static int __init gm8210_init(void)
+{
+	return of_platform_populate(NULL, of_default_bus_match_table, NULL, NULL);
+}
+arch_initcall(gm8210_init);
+
+static int __init gm8210_late_init(void)
+{
+	return 0;
-- 
2.34.1
