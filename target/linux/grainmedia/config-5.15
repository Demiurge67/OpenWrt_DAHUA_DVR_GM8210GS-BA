# Architecture
CONFIG_ARM=y
CONFIG_ARCH_GM8210=y
CONFIG_MACH_GM8210=y
CONFIG_CPU_ARM926T=y
CONFIG_ARM_LPAE=n
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_WERROR=n
CONFIG_CPU_32v5=y
CONFIG_CPU_ABRT_EV5TJ=y
CONFIG_CPU_CACHE_VIVT=y
CONFIG_CPU_TLB_V4WBI=y
CONFIG_FPE_NWFPE=y
CONFIG_FPE_NWFPE_XP=n
CONFIG_FPE_FASTFPE=n
CONFIG_COMMON_CLK=y
CONFIG_AEABI_FORCE_32BIT=y
CONFIG_ARCH_MULTI_V5=n

# Disable other platforms
CONFIG_ARCH_MULTIPLATFORM=n
CONFIG_ARCH_MULTI_V4=n
CONFIG_ARCH_MULTI_V4T=n
CONFIG_ARCH_MULTI_V6=n
CONFIG_ARCH_MULTI_V7=n

# Processor features
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_UNWINDER_ARM=y

# Cache
CONFIG_CPU_ICACHE_DISABLE=n
CONFIG_CPU_DCACHE_DISABLE=n
CONFIG_CPU_DCACHE_WRITETHROUGH=n
CONFIG_CPU_CACHE_ROUND_ROBIN=n

# Memory
CONFIG_PHYS_OFFSET=0x80000000
CONFIG_VMSPLIT_3G=y

# Boot loader
CONFIG_ZBOOT_ROM_TEXT=0x0
CONFIG_ZBOOT_ROM_BSS=0x0
CONFIG_CMDLINE="console=ttyS0,115200 earlyprintk"
CONFIG_CMDLINE_FROM_BOOTLOADER=y

# Device Tree
CONFIG_OF=y
CONFIG_USE_OF=y
CONFIG_ATAGS=y
CONFIG_DEPRECATED_PARAM_STRUCT=n

# Filesystems
CONFIG_JFFS2_FS=y
CONFIG_SQUASHFS=y
CONFIG_UBIFS_FS=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EARLYCON=y
CONFIG_SERIAL_8250_GM=y
CONFIG_SERIAL_8250_DMA=n
CONFIG_SERIAL_8250_RUNTIME_UARTS=2

# Network
CONFIG_NETDEVICES=y
CONFIG_FTGMAC100=y
CONFIG_NET_VENDOR_FARADAY=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NFS_FS=y
CONFIG_ROOT_NFS=y

# SPI and Flash
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_MTD_M25P80=y

# Initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# USB
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_GM_EHCI_HCD=y
CONFIG_USB_GM_OHCI_HCD=y

# Debugging
CONFIG_DEBUG_KERNEL=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y

# Grain Media specific drivers
CONFIG_CLK_GM=y
CONFIG_PINCTRL_GM=y
CONFIG_POWER_GM=y
CONFIG_VIDEO_GM_H264_DECODER=y
CONFIG_VIDEO_GM_JPEG_DECODER=y
CONFIG_SND_GM_AUDIO=y
CONFIG_SND_SOC_GM_I2S=y
CONFIG_GM_DMA_ENGINE=y
CONFIG_GM_INTC=y
CONFIG_CLKSRC_GM_TIMER=y
CONFIG_PWM_GM=y
CONFIG_I2C_GM=y
CONFIG_GPIO_GM=y
CONFIG_MMC_GM_SDHCI=y
CONFIG_RTC_DRV_GM=y
CONFIG_GM_WATCHDOG=y
CONFIG_GM_THERMAL=y
CONFIG_CRYPTO_DEV_GM_ACE=y
CONFIG_CRYPTO_DEV_GM_HASH=y
CONFIG_GM_L2_CACHE=y
CONFIG_GM_EMI_CTRL=y
