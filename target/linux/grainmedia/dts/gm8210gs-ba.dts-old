/dts-v1/;

#include "gm8210.dtsi"

/ {
    model = "Dahua GM8210GS-BA";
    compatible = "dahua,gm8210gs-ba", "faraday,gm8210";

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x40000000>;
    };

    chosen {
        bootargs = "console=ttyS0,115200 earlycon mem=1G";
        stdout-path = &uart0;
    };
};

&uart0 {
    status = "okay";
};

&eth0 {
    status = "okay";
};

&spi0 {
    status = "okay";
    
    flash@0 {
        compatible = "winbond,w25q128", "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <50000000>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            partition@0 {
                label = "boot";
                reg = <0x000000 0x060000>;
            };

            partition@60000 {
                label = "rootfs";
                reg = <0x060000 0xC80000>;
            };

            partition@ce0000 {
                label = "web";
                reg = <0xCE0000 0x180000>;
            };

            partition@e60000 {
                label = "custom";
                reg = <0xE60000 0x020000>;
            };

            partition@e80000 {
                label = "logo";
                reg = <0xE80000 0x040000>;
            };

            partition@ec0000 {
                label = "config";
                reg = <0xEC0000 0x140000>;
            };
        };
    };
};
